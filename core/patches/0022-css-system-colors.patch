+#if !BUILDFLAG(IS_WIN)
+namespace {
+
+// fury: Windows resolves CSS system colours from the native Win32 palette in
+// the light scheme (ui/color/win/css_system_color_mixer_win.cc); the built-in
+// cross-platform palette used on Linux and macOS differs, and since M138 its
+// ActiveText is pure red. A Linux build whose config claims a Windows machine
+// must send the Windows values to the renderer, or the page reads the OS off
+// the colour alone. Values are the stock Windows 10/11 theme defaults
+// (HKCU\Control Panel\Colors), i.e. what GetSysColor() returns on a machine
+// nobody has recoloured. Dark and forced-colors maps are left alone: Windows
+// Chrome uses the built-in palette in dark mode too.
+void FuryApplyWindowsCssSystemColors(ui::RendererColorMap& map) {
+  const SkColor hotlight = SkColorSetRGB(0x00, 0x66, 0xCC);  // COLOR_HOTLIGHT
+  map[::color::mojom::RendererColorId::kColorCssSystemActiveText] = hotlight;
+  map[::color::mojom::RendererColorId::kColorCssSystemHotlight] = hotlight;
+  map[::color::mojom::RendererColorId::kColorCssSystemLinkText] = hotlight;
+  map[::color::mojom::RendererColorId::kColorCssSystemVisitedText] = hotlight;
+  map[::color::mojom::RendererColorId::kColorCssSystemHighlight] =
+      SkColorSetRGB(0x00, 0x78, 0xD7);  // COLOR_HIGHLIGHT
+  map[::color::mojom::RendererColorId::kColorCssSystemMenuHilight] =
+      SkColorSetRGB(0x00, 0x78, 0xD7);  // COLOR_MENUHILIGHT
+  map[::color::mojom::RendererColorId::kColorCssSystemBtnFace] =
+      SkColorSetRGB(0xF0, 0xF0, 0xF0);  // COLOR_BTNFACE
+  map[::color::mojom::RendererColorId::kColorCssSystemGrayText] =
+      SkColorSetRGB(0x6D, 0x6D, 0x6D);  // COLOR_GRAYTEXT
+  map[::color::mojom::RendererColorId::kColorCssSystemScrollbar] =
+      SkColorSetRGB(0xF0, 0xF0, 0xF0);  // COLOR_SCROLLBAR
+}
+
+}  // namespace
+#endif  // !BUILDFLAG(IS_WIN)
+
