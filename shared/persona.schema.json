{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furybrowser.dev/schemas/persona.schema.json",
  "title": "Device persona",
  "description": "A real-world machine configuration. Personas are the source of truth for fingerprint generation: a profile picks one, and every spoofed value is derived from it plus the profile seed. Making values up independently produces combinations that do not exist in nature, which is a stronger signal than not spoofing at all.",
  "type": "object",
  "required": ["id", "weight", "os", "gpu", "screen", "chrome_metrics", "cpu", "memory_gb", "fonts", "audio"],
  "additionalProperties": false,
  "allOf": [{
    "if": { "properties": { "os": { "properties": { "name": { "const": "Linux" } } } } },
    "then": {
      "properties": {
        "os": { "properties": {
          "platform": { "const": "Linux x86_64" },
          "ch_platform": { "const": "Linux" },
          "user_agent_template": { "pattern": "Linux" }
        } },
        "gpu": { "properties": {
          "webgl_renderer": { "not": { "pattern": "Direct3D|D3D11|Metal" } }
        } }
      }
    }
  }],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Stable identifier, e.g. win11-chrome-rtx4060-1080p."
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Share of the real population. Personas below 0.005 are never auto-assigned: a rare-but-real configuration still narrows the crowd you hide in."
    },
    "source": {
      "type": "string",
      "enum": ["measured", "capture", "telemetry", "public-dataset"],
      "description": "Where the numbers came from. 'measured' means someone dumped them off a physical machine."
    },
    "contributed_by": { "type": ["string", "null"] },
    "machine": { "type": ["string", "null"] },
    "os": {
      "type": "object",
      "required": ["name", "version", "arch", "user_agent_template", "platform", "ch_platform", "ch_platform_version", "ch_architecture", "ch_bitness"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["Windows", "macOS", "Linux", "Android"] },
        "version": { "type": "string" },
        "build": { "type": "string" },
        "arch": { "enum": ["x86", "x86_64", "arm", "arm64"] },
        "user_agent_template": { "type": "string" },
        "platform": { "type": "string" },
        "ch_platform": { "type": "string" },
        "ch_platform_version": { "type": "string" },
        "ch_architecture": { "type": "string" },
        "ch_bitness": { "type": "string" }
      }
    },
    "gpu": {
      "type": "object",
      "required": ["webgl_vendor", "webgl_renderer"],
      "additionalProperties": false,
      "properties": {
        "webgl_vendor": { "type": "string" },
        "webgl_renderer": { "type": "string" },
        "webgl_params": {
          "type": "object",
          "description": "All ~80 getParameter constants. Dump them from the real machine rather than guessing; several are checked individually.",
          "additionalProperties": true
        },
        "webgl_extensions": { "type": "array", "items": { "type": "string" } },
        "webgpu": {
          "type": ["object", "null"],
          "description": "Must describe the same physical GPU as the WebGL fields. Leaving this unset while WebGL is spoofed is a ready-made detection vector.",
          "required": ["vendor", "architecture"],
          "additionalProperties": false,
          "properties": {
            "vendor": { "type": "string" },
            "architecture": { "type": "string" },
            "device": { "type": "string" },
            "description": { "type": "string" },
            "limits": { "type": "object", "additionalProperties": { "type": "number" } },
            "features": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "required": ["width", "height", "avail_width", "avail_height", "color_depth", "device_pixel_ratio"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 640 },
        "height": { "type": "integer", "minimum": 480 },
        "avail_width": { "type": "integer" },
        "avail_height": {
          "type": "integer",
          "description": "Strictly less than height on macOS — the menu bar is always reserved."
        },
        "color_depth": { "type": "integer", "enum": [24, 30, 32] },
        "device_pixel_ratio": { "type": "number", "minimum": 0.5, "maximum": 4.5 }
      }
    },
    "chrome_metrics": {
      "type": "object",
      "description": "Browser chrome dimensions. Routinely measured via outerHeight - innerHeight and clientWidth vs innerWidth; wrong values contradict the claimed OS.",
      "required": ["outer_minus_inner_height", "scrollbar_width"],
      "additionalProperties": false,
      "properties": {
        "outer_minus_inner_height": { "type": "integer", "minimum": 0 },
        "outer_minus_inner_width": { "type": "integer", "minimum": 0 },
        "scrollbar_width": {
          "type": "integer",
          "description": "0 on macOS; Windows reserves scrollbar width. Linux depends on the compositor and theme."
        }
      }
    },
    "cpu": {
      "type": "object",
      "required": ["cores"],
      "additionalProperties": false,
      "properties": {
        "cores": { "type": "integer", "minimum": 2, "maximum": 128 },
        "model": { "type": ["string", "null"] }
      }
    },
    "memory_gb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483648,
      "description": "Quantised navigator.deviceMemory from the capture, not physical RAM. The runtime additionally requires a power of two; 16 and 32 occur in the current captures."
    },
    "max_touch_points": { "type": "integer", "minimum": 0, "default": 0 },
    "fonts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Measured font set for this OS build, including Linux. This drives the fallback filter in patch 0050."
    },
    "audio": {
      "type": "object",
      "required": ["sample_rate", "base_latency", "output_latency"],
      "additionalProperties": false,
      "properties": {
        "sample_rate": { "type": "integer", "enum": [8000, 11025, 16000, 22050, 32000, 44100, 48000, 88200, 96000, 176400, 192000] },
        "base_latency": { "type": "number" },
        "output_latency": { "type": "number" }
      }
    },
    "voices": {
      "type": "array",
      "items": { "type": "string" },
      "description": "speechSynthesis.getVoices(). Platform-specific and frequently checked."
    },
    "media_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["audioinput", "audiooutput", "videoinput"] },
          "label_hint": { "type": "string" }
        }
      }
    },
    "mobile": {
      "type": "object",
      "required": ["model", "form_factor", "connection"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "form_factor": { "enum": ["phone", "tablet"] },
        "connection": { "enum": ["cellular", "wifi"] }
      }
    },
    "codecs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Supported media types. A build without proprietary_codecs fails these and is identified as a self-built Chromium in two lines of JS."
    }
  }
}
