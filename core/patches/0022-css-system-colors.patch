@@ -8908,6 +8943,18 @@
           ui::ColorProviderKey::ForcedColors::kNone),
       forced_colors_source->GetRendererColorMap(
           forced_colors_source->GetColorMode(), forced_colors)};
+
+#if !BUILDFLAG(IS_WIN)
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    const std::optional<std::string> platform =
+        config->GetString("navigator.platform");
+    if (platform && *platform == "Win32") {
+      FuryApplyWindowsCssSystemColors(color_maps.light_colors_map);
+    }
+  }
+
+#endif  // !BUILDFLAG(IS_WIN)
+  return color_maps;
